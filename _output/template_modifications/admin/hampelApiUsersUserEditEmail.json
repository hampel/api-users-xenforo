{
    "template": "user_edit",
    "description": "Replace the email field with a note for an API user",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#<xf:textboxrow name=\"user\\[email\\]\".*/>#sU",
    "replace": "<xf:if is=\"$user.user_id AND $user.ApiUser\">\n\t\t\t\t\t\t<xf:formrow label=\"{{ phrase('email') }}\">{{ phrase('hampel_apiusers_none_api_user_cannot_have_one') }}</xf:formrow>\n\t\t\t\t\t<xf:else />\n\t\t\t\t\t\t$0\n\t\t\t\t\t</xf:if>"
}