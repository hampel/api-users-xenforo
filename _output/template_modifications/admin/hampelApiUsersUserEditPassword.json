{
    "template": "user_edit",
    "description": "Replace the password options with a note for an API user",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#<xf:radiorow name=\"change_password\".*</xf:radiorow>#sU",
    "replace": "<xf:if is=\"$user.ApiUser\">\n\t\t\t\t\t\t\t<xf:formrow label=\"{{ phrase('password') }}\">{{ phrase('hampel_apiusers_none_api_user_cannot_have_one') }}</xf:formrow>\n\t\t\t\t\t\t<xf:else />\n\t\t\t\t\t\t\t$0\n\t\t\t\t\t\t</xf:if>"
}